.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
state/

# Build artefacts. `uv build` writes dist/, and an editable install leaves an
# egg-info behind; neither is source.
dist/
build/
*.egg-info/

# Local config and scratch, as opposed to the committed examples.
agents.toml
# Holds the roster: real Slack user ids and email addresses.
policy.toml
smoke/
smoke.log
*.log

# Runtime directories the compose file mounts. claude-config/ holds live
# credentials whenever a stored login is used; workspace/ holds whole
# checkouts. Neither belongs in the history.
claude-config/
workspace/
