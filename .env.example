# Slack app credentials. Copy to .env, which is gitignored.
#
# Both come from one Slack app at https://api.slack.com/apps:
#   SLACK_APP_TOKEN  Basic Information -> App-Level Tokens, scope connections:write
#   SLACK_BOT_TOKEN  OAuth & Permissions, after installing the app to a workspace
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# The credential Claude Code itself uses. A Console API key from
# https://console.anthropic.com, and the one credential here with no scheduled
# failure built in: it ends when you rotate it rather than on a clock you
# cannot see. That is what a box nobody logs into wants.
#
# Leave it out only if you are signing in instead with `docker compose run
# --rm login`. Do not do both -- a stored login can take precedence, which
# leaves this as decoration. See docs/running.md.
ANTHROPIC_API_KEY=sk-ant-...

# Where thread-to-agent bindings live. Defaults to ./state next to agents.toml.
# RICARDI_STATE_DIR=./state
