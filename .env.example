# Slack app credentials. Copy to .env, which is gitignored.
#
# Both come from one Slack app at https://api.slack.com/apps:
#   SLACK_APP_TOKEN  Basic Information -> App-Level Tokens, scope connections:write
#   SLACK_BOT_TOKEN  OAuth & Permissions, after installing the app to a workspace
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Where thread-to-agent bindings live. Defaults to ./state next to agents.toml.
# RICARDI_STATE_DIR=./state
